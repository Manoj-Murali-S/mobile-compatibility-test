{
  "name": "mobile-compatibility-finder",
  "productName": "Mobile Compatibility Finder",
  "version": "1.0.0",
  "description": "Offline-first mobile compatibility catalog — Electron + SQLite + Next.js",
  "author": "Cell's and Cell",
  "private": true,
  "main": ".electron/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "electron:compile": "tsc -p tsconfig.electron.json",
    "electron:rebuild": "electron-rebuild -f -w better-sqlite3",
    "electron:dev": "concurrently --kill-other \"next dev\" \"wait-on http://localhost:3000 && cross-env NODE_ENV=development electron .\"",
    "electron:build": "next build && tsc -p tsconfig.electron.json",
    "electron:start": "cross-env NODE_ENV=production electron .",
    "electron:package": "npm run electron:build && electron-forge package --out release",
    "electron:make": "npm run electron:build && electron-forge make --out release"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@supabase/supabase-js": "^2.112.3",
    "@vercel/analytics": "1.6.1",
    "better-auth": "^1.6.27",
    "better-sqlite3": "^12.11.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dexie": "^4.4.4",
    "drizzle-orm": "^0.45.2",
    "electron-serve": "^3.0.1",
    "electron-squirrel-startup": "^1.0.1",
    "framer-motion": "^13.0.0",
    "lucide-react": "^1.16.0",
    "next": "16.3.0",
    "next-themes": "^0.4.6",
    "pg": "^8.23.0",
    "react": "^19",
    "react-dom": "^19",
    "shadcn": "^4.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-rpm": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.2",
    "@electron-forge/plugin-webpack": "^7.11.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24",
    "@types/pg": "^8.21.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^43.4.0",
    "@electron/rebuild": "^3.2.13",
    "postcss": "^8.5",
    "tailwindcss": "^4.3.3",
    "typescript": "5.7.3",
    "wait-on": "^9.1.0"
  }
}
