# Mobile Compatibility Finder — Environment Variables
# Copy this file to .env.local and fill in your values.
# The app works FULLY OFFLINE without any of these set.

# ─── SQLite ────────────────────────────────────────────────────────────────────
# No DATABASE_URL needed! SQLite is a local file managed by Electron.
# Location: %APPDATA%\mobile-compatibility-finder\catalog.db (Windows)
#           ~/Library/Application Support/mobile-compatibility-finder/catalog.db (macOS)

# ─── Supabase Sync (OPTIONAL) ──────────────────────────────────────────────────
# Only needed if you want to sync local SQLite data to a cloud Supabase project.
# Leave these blank to run in fully offline mode.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service role key (for server-side sync operations, never expose to browser)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ─── Legacy PostgreSQL (deprecated, not used in offline-first mode) ─────────────
# DATABASE_URL is only required if deploying the web version to Vercel/Neon.
# For the Electron desktop app, leave this blank.
# DATABASE_URL=postgresql://user:password@host/database

# BETTER_AUTH_SECRET=your-secret-here  # Only needed for web auth
